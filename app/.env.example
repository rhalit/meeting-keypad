# Copy to app/.env (never commit app/.env). Any OpenAI-compatible chat API works.

# --- Groq (free tier) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# gpt-oss reasons before answering; "low" keeps Catch-up's first token under ~3 s.
LLM_REASONING_EFFORT=low

# --- Ollama (local, no key) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=gpt-oss:20b
# LLM_API_KEY=
# LLM_REASONING_EFFORT=low

# --- OpenRouter ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-oss-120b:free
# LLM_API_KEY=sk-or-...
# LLM_REASONING_EFFORT=low

# Optional: "object" skips json_schema and uses JSON mode + validation right away
# (the app also switches automatically if the server rejects json_schema).
# LLM_JSON_MODE=schema

# --- Speech-to-text (Phase 3a): Deepgram live, model nova-3 ---
# Key from console.deepgram.com → API Keys. Never commit or print it.
DEEPGRAM_API_KEY=
# "en" (default), or "multi" for mixed English/French in one meeting.
# DEEPGRAM_LANGUAGE=en
# Optional: diarization labels lines "Speaker 1", "Speaker 2" (default true).
# DEEPGRAM_DIARIZE=true
# Optional: silence (ms) that ends an utterance; default 300 for en, 100 for multi.
# DEEPGRAM_ENDPOINTING_MS=300
# Optional: path to the audiotee binary (default tools/audiotee/bin/audiotee).
# AUDIOTEE_PATH=
