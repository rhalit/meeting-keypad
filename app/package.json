{
  "name": "meeting-keypad-app",
  "private": true,
  "version": "0.3.0",
  "description": "Meeting Keypad app: pipeline, keypad WebSocket server and control panel",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p . && tsc -p tsconfig.renderer.json",
    "dev": "npm run build && electron .",
    "typecheck": "tsc -p . --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "smoke": "npm run build && node dist/tools/smoke.js",
    "smoke:live": "npm run build && node dist/tools/liveSmoke.js",
    "eval:terms": "npm run build && node dist/tools/evalTerms.js",
    "record:live": "npm run build && node dist/tools/recordLive.js",
    "replay:live": "npm run build && node dist/tools/replayLive.js",
    "build:audiotee": "../tools/audiotee/build.sh"
  },
  "dependencies": {
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "electron": "45.2.3",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
